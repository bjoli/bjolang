

(defun (id x) x)
(type-rec
  ((List 'a)
    (: Cons 'a (List 'a))
    Nil))

(defun (is-empty lst)
  (match lst
    (Nil #t)
    ((Cons _ _) #f)))
(defun (head lst)
  (match lst
    ((Cons h _) h)))
(defun (tail lst)
  (match lst
    ((Cons _ t) t)))

(defun (map f lst)
  (if (is-empty lst)
      Nil
      (Cons (f (head lst)) (map f (tail lst))                             )))

      
;; Higher-order function returning a captured closure with generics
(defun (make-mapper f)
  (fun (lst) (map f lst)))

(defun (main args)
  (def my-list (Cons "hej" (Cons "då" Nil)))
  (defun (my-mapper lst)
    (let ((mapper (make-mapper id)))
     (mapper lst)))
  (def h (my-mapper my-list))
  (displayln "h generated!")
  (displayln (head h))
  0)
