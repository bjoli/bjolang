
(import (std list))

(defun (id x) x)



      
;; Higher-order function returning a captured closure with generics
(defun (make-mapper f)
  (fun (lst) (map f lst)))

(defun (main args)
  (def my-list (Cons "hej" (Cons "då" Nil)))
  (defun (my-mapper lst)
    (let ((mapper (make-mapper id)))
     (mapper lst)))
  (def h (my-mapper my-list))
  (displayln "h generated!")
  (displayln (head h))
  0)
