(import (std prelude))
(export poop-on-you)

(: get-name (-> string))
(defun (get-name)
  (displayln "What is your name? ")
  (def name (read-line))
  (if (equal? name "")
      (get-name)
      name))

(: poop-on-you (-> System.Void))
(defun (poop-on-you)
  (def name (get-name))
  (display "Poop on you, ")
  (displayln name))
