;; `abs` reaching a consuming module through `prelude.dll`.
;;
;; It is a trait method, so what crosses the boundary is the `Num` trait, its
;; impls and their inline templates — not a signature, which is the one thing an
;; overload set cannot be reduced to.
(import (std prelude))

(: expect (-> string string string void))
(defun (expect label actual wanted)
  (if (= actual wanted)
      (println (string-append "ok: " label))
      (println (string-append "FAILURE: " (string-append label
                (string-append " gave " (string-append actual
                (string-append " but wanted " wanted))))))))

;; A `Num`-constrained function defined on this side of the boundary, dispatched
;; through a dictionary built from the imported impls.
;;
;; Only `abs` is asked of `%a`: arithmetic on a constrained type variable is a
;; separate matter, since `+` is not a member of any trait and C# has no
;; operator to emit for an unconstrained generic parameter.
(: twice-abs (-> %a %a) (where (Num %a)))
(defun (twice-abs x)
  (abs (abs x)))

(defun (main)
  (expect "abs int" (int->string (abs -5)) "5")
  (expect "abs int positive" (int->string (abs 5)) "5")
  (expect "abs double" (double->string (abs -2.5)) "2.5")
  (expect "abs long" (long->string (abs -3000000000L)) "3000000000")
  (expect "sqrt" (double->string (sqrt 9.0)) "3")
  (expect "imported constraint, int" (int->string (twice-abs -3)) "3")
  (expect "imported constraint, double" (double->string (twice-abs -1.5)) "1.5")
  0)
