        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Paths.fs"/>
        <Compile Include="Gensym.fs"/>
        <Compile Include="Naming.fs"/>
        <Compile Include="Lexer.fs"/>
        <Compile Include="Parser.fs"/>
