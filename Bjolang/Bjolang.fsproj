        <Compile Include="TypedAST.fs" />
        <Compile Include="TypeVisitor.fs" />
        <Compile Include="AlphaRename.fs" />
        <Compile Include="Unification.fs" />
        <Compile Include="Inference.fs" />
        <Compile Include="TraitInline.fs" />
        <Compile Include="Lowering.fs" />
        <Compile Include="LoopLowering.fs" />
        <Compile Include="Prelude.fs" />
        <Compile Include="Pipeline.fs"/>
        <Compile Include="Codegen.fs"/>
        <Compile Include="Program.fs" />
    </ItemGroup>

</Project>
