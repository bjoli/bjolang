(def/trait (Foldable %col)
  (type %item)
  (: fold (-> %col %acc (-> %acc %item %acc) %acc)))


(def/impl (Foldable (List %a))
  (type %item %a)
  (defun (fold col acc f)
    (list-foldl col acc f)))

(def/impl (Foldable (Vec %a))
  (type %item %a)
  (defun (fold col acc f)
    (vec-fold col acc f)))
