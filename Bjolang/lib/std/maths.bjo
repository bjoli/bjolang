;; std/maths.bjo
;;
;; `System.Math`, in the two shapes it actually comes in.
;;
;; Most of it is one method taking a double: `Sin`, `Log`, `Cbrt`. Those need
;; nothing but a name, and are exported as the imports themselves — an int
;; argument widens to double at the call exactly as it would in C#.
;;
;; A handful are *overload sets*: one method per numeric type, with the type
;; preserved through the call. `(abs -5)` is an int and `(abs -2.5)` is a
;; double, and no single signature can say that. Those are the `Num` trait
;; below, which is also what lets them be named in generic code — an overload
;; set cannot be, since resolving one needs argument types that a polymorphic
;; body does not have.

(export
  ;; Num
  abs sign min max clamp sqrt
  ;; Exponential and logarithmic
  cbrt exp pow log log2 log10
  ;; Rounding
  floor ceiling truncate round
  ;; Trigonometric
  sin cos tan asin acos atan atan2
  ;; Hyperbolic
  sinh cosh tanh asinh acosh atanh)

;; ---------------------------------------------------------------------------
;; Num
;; ---------------------------------------------------------------------------

;; The overload sets, bound once and left unexported: each is the *set*, and the
;; trait method of the same shape is the exported name. A default body is
;; re-checked at every impl, so one line of body covers every implementor —
;; `(clr-abs x)` is `Abs(int)` under `(Num int)` and `Abs(double)` under
;; `(Num double)`, resolved from an argument type that does not exist until the
;; implementor is known.
(import/extern
  (clr-abs   (: System.Math.Abs))
  (clr-sign  (: System.Math.Sign))
  (clr-min   (: System.Math.Min))
  (clr-max   (: System.Math.Max))
  (clr-clamp (: System.Math.Clamp))
  (clr-sqrt  (: System.Math.Sqrt)))

;; What belongs here is exactly what `System.Math` overloads *per numeric type*.
;; Everything else in this file is a double function and needs no dispatch.
;;
;; `sign` and `sqrt` are in it despite fixing their result type. Neither result
;; depends on the implementor — a sign is a sign and there is no integer square
;; root — but both are still operations *on* a `Num`, and putting them here is
;; what lets a `(where (Num %a))` function call them. A trait method's result is
;; not obliged to mention the implementor.
(def/trait (Num %a)
  (: abs   (-> %a %a))
  (: sign  (-> %a int))
  (: min   (-> %a %a %a))
  (: max   (-> %a %a %a))
  (: clamp (-> %a %a %a %a))
  (: sqrt  (-> %a double))

  (defun (abs x) (clr-abs x))
  (defun (sign x) (clr-sign x))
  (defun (min a b) (clr-min a b))
  (defun (max a b) (clr-max a b))
  (defun (clamp x lo hi) (clr-clamp x lo hi))
  ;; `Sqrt` is the one overload there is, so the integer implementors convert.
  ;; The cast is written rather than left implicit: overload resolution accepts
  ;; a widening argument, but the parameter type is then unified into the
  ;; argument, so an int reaching a double parameter has to say so.
  (defun (sqrt x) (clr-sqrt (cast double x))))

;; The signed types, and only those: `Math.Abs` and `Math.Sign` have no unsigned
;; overload, an unsigned type having neither a sign to report nor anything to
;; negate. So `byte`, `ushort`, `uint` and `ulong` are not `Num` — `(abs b)` on
;; one says so, instead of widening behind your back and handing back a type
;; nobody asked for.
;;
;; `short` is absent for a different reason: C# promotes it to int on every
;; arithmetic operation, so a `short` implementor would be a type you cannot do
;; arithmetic in. `decimal` and `float` are absent because Bjolang has no name
;; for them yet; both would be an impl and nothing else once it does.
(def/impl (Num int))
(def/impl (Num long))
(def/impl (Num double))

;; Todo: `min`/`max` over a sequence rather than a pair. That is a function over
;; a `Num`-constrained element type — `(: min-of (-> %s %a) (where (Num %a)))` —
;; rather than another method here, since a rest parameter is a calling
;; convention and a trait method's shape is fixed by the trait.

;; ---------------------------------------------------------------------------
;; The double functions
;; ---------------------------------------------------------------------------

;; One method each, so the import *is* the export: there is nothing for a
;; wrapper to add, and the importing module resolves the call against the same
;; .NET metadata this one did.

;; Exponential and logarithmic. `pow` is (base, exponent); `log` is the natural
;; logarithm at one argument and log-to-base at two, which is the overload set
;; `Math.Log` already is.
(import/extern
  (cbrt  (: System.Math.Cbrt))
  (exp   (: System.Math.Exp))
  (pow   (: System.Math.Pow))
  (log   (: System.Math.Log))
  (log2  (: System.Math.Log2))
  (log10 (: System.Math.Log10)))

;; Rounding. Each of these has a decimal overload as well as a double one, so
;; they stay imports rather than becoming signatures: a double argument picks
;; the double overload, and a decimal one would pick the decimal overload the
;; day Bjolang can spell it.
(import/extern
  (floor    (: System.Math.Floor))
  (ceiling  (: System.Math.Ceiling))
  (truncate (: System.Math.Truncate))
  (round    (: System.Math.Round)))

;; Trigonometric. `atan2` takes (y, x), in that order, and is the one to reach
;; for when the quadrant matters.
(import/extern
  (sin   (: System.Math.Sin))
  (cos   (: System.Math.Cos))
  (tan   (: System.Math.Tan))
  (asin  (: System.Math.Asin))
  (acos  (: System.Math.Acos))
  (atan  (: System.Math.Atan))
  (atan2 (: System.Math.Atan2)))

;; Hyperbolic.
(import/extern
  (sinh  (: System.Math.Sinh))
  (cosh  (: System.Math.Cosh))
  (tanh  (: System.Math.Tanh))
  (asinh (: System.Math.Asinh))
  (acosh (: System.Math.Acosh))
  (atanh (: System.Math.Atanh)))
