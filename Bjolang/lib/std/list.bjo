;; std/list.bjo
;; The List type, defined natively in Bjolang

(export empty? head tail reverse map foldl foldr filter length)


(type-rec
  ((List %a)
    (: Cons %a (List %a))
    Nil))

;; Standard list operations

(: empty? (-> (List %a) bool))
(defun (empty? lst)
  (match lst
    (Nil true)
    (_ false)))

(: head (-> (List %a) %a))
(defun (head lst)
  (match lst
    ((Cons x _) x)))

(: tail (-> (List %a) (List %a)))
(defun (tail lst)
  (match lst
    ((Cons _ xs) xs)))

(: reverse (-> (List %a) (List %a)))
(defun (reverse lst)
  (let loop ((acc Nil) (lst lst))
    (if (empty? lst)
        acc
        (loop (Cons (head lst) acc) (tail lst)))))

(: map (-> (-> %a %b) (List %a) (List %b)))
(defun (map f lst)
  (let loop ((acc Nil) (lst lst))
    (if (empty? lst)
        (reverse acc)
        (loop (Cons (f (head lst)) acc) (tail lst)))))

(: foldl (-> (-> %a %b %a) %a (List %b) %a))
(defun (foldl f init lst)
  (if (empty? lst)
      init
      (foldl f (f init (head lst)) (tail lst))))

(: foldr (-> (-> %a %b %b) %b (List %a) %b))
(defun (foldr f init lst)
  (if (empty? lst)
      init
      (f (head lst) (foldr f init (tail lst)))))

(: filter (-> (-> %a bool) (List %a) (List %a)))
(defun (filter p lst)
  (if (empty? lst)
      Nil
      (if (p (head lst))
          (Cons (head lst) (filter p (tail lst)))
          (filter p (tail lst)))))

(: length (-> (List %a) int))
(defun (length lst)
  (if (empty? lst)
      0
      (+ 1 (length (tail lst)))))

