(import (std prelude))

(: erathostenes (-> int (List int)))
(defun (erathostenes n)
  (def vec (make-vector n #t))
  (loop (:for i (up-from 2 (:to n)))
         (:when (vector-ref vec i))
         (:acc lst (listing i))
         (:for j (up-from (* 2 i) (:to n) (:by i)))
         (:do (vector-set! vec j #f))))

(defun (main args)
  (erathostenes 100)
  0)

