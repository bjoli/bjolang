# .gitignore for Bjolang

# IDE files
.idea/
*.suo
*.user
*.sln.docstates

# Build artifacts
bin/
obj/
Bjolang/bin/
Bjolang/obj/

# Generated binaries
*.exe
*.dll
*.pdb
*.runtimeconfig.json
*.deps.json
*.il

# The apphost the SDK emits alongside an .exe has no extension at all, so it
# cannot be matched by suffix. Anything under TestFiles is already ignored
# wholesale below; this covers the same output under Playground.
Bjolang/Playground/**/*
!Bjolang/Playground/**/*.bjo
!Bjolang/Playground/**/*.py

# Written by the frontend on every --debug compile.
Bjolang/out.cs

# Log files and compiler trace files
*.log
*.txt
ast_dump*.txt
scheme_dump*.txt
unify_dump*.txt
eapp_debug.txt
il_dump.txt
il_summary.txt
test_debug*.txt
dump*.log
dump*.txt

# Exclude build output under TestFiles and lib
Bjolang/TestFiles/*.exe
Bjolang/TestFiles/*.runtimeconfig.json
Bjolang/TestFiles/lib/
Bjolang/lib/*.exe
Bjolang/lib/*.runtimeconfig.json
Bjolang/TestFiles/**/*
Bjolang/cs-snapshots/**/*


# But make sure standard library source files are not ignored
!Bjolang/lib/std/**/*.bjo
!Bjolang/TestFiles/**/*.bjo
*.diff
